# Copy to .env and adjust. No API keys are required by the current data sources
# (FastF1 + Jolpica-F1). Load with:  uv run --env-file .env <command>

# Override the data directory (default: <repo>/data)
# F1PA_DATA_DIR=/absolute/path/to/data

# FastF1 cache location (default: <data_dir>/cache/fastf1). FastF1 also reads
# FASTF1_CACHE itself; this project passes the resolved path explicitly.
# FASTF1_CACHE=/absolute/path/to/fastf1-cache

# Logging: DEBUG | INFO | WARNING | ERROR ; format: text | json
# F1PA_LOG_LEVEL=INFO
# F1PA_LOG_FORMAT=text
